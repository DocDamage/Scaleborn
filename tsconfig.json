{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src", "tests"]
}
